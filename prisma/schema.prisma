generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One verification run of one meeting. The full report (speakers, verdicts,
/// possibly-missed tasks, referee notes) is stored as JSON.
model VerificationRun {
  id         String   @id @default(cuid())
  meetingId  String
  model      String
  createdAt  DateTime @default(now())
  reportJson String

  @@index([meetingId, createdAt])
}
