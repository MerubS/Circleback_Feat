# SQLite for local dev. For Postgres: set provider = "postgresql" in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Required. The AI reads each meeting once (a few cents per meeting; answers are cached in .data/ai-cache).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# "sample" reads meeting files in data/samples and data/imported. "api" reads your Circleback workspace.
MEETING_SOURCE="sample"
CIRCLEBACK_API_KEY=""
CIRCLEBACK_API_BASE="https://app.circleback.ai/api/v1"

# "file" (default, JSON in .data/) or "prisma" (run `npm run db:setup` first)
STORAGE="file"
