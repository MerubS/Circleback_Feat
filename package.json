{
  "name": "action-item-verifier",
  "version": "0.1.0",
  "private": true,
  "description": "Checks every AI-generated meeting action item against the transcript and labels it Supported, Weak, Unsupported, or Owner not confirmed.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "eval": "tsx scripts/eval.ts",
    "verify": "tsx scripts/verify.ts",
    "db:push": "prisma db push",
    "db:setup": "prisma generate && prisma db push"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "next": "14.2.35",
    "openai": "4.104.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
